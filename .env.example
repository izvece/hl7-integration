# ---------------------------------------------------------------------------
# Kopieren nach .env und Passwoerter ersetzen:  cp .env.example .env
# Die .env steht in .gitignore und gehoert NICHT ins Repository.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bitte_aendern_postgres
POSTGRES_DB=hl7

# Eigentuemer der internen Mirth-Datenbank
MIRTH_DB_PASSWORD=bitte_aendern_mirth

# Der Benutzer, mit dem der Kanal arbeitet
HL7_APP_PASSWORD=bitte_aendern_app

# Der nur lesende Benutzer fuer den Prometheus-Exporter
HL7_MONITOR_PASSWORD=bitte_aendern_monitor

# --- Mirth Connect ---------------------------------------------------------
# Zugang zur Weboberflaeche unter https://localhost:8443
# Mirth startet mit admin/admin. Beim ERSTEN Login in der Weboberflaeche
# verlangt es eine Aenderung - danach hier den neuen Wert eintragen.
# Bis dahin bleibt MIRTH_ADMIN_PASSWORD=admin richtig.
MIRTH_ADMIN_USER=admin
MIRTH_ADMIN_PASSWORD=admin

# Passwoerter des mitgelieferten Keystores. Fuer lokal in Ordnung, fuer echten
# Betrieb durch ein eigenes Zertifikat ersetzen.
MIRTH_KEYSTORE_STOREPASS=bitte_aendern_keystore
MIRTH_KEYSTORE_KEYPASS=bitte_aendern_keystore

# --- Ports auf dem Host ----------------------------------------------------
MLLP_PORT=6661
MIRTH_HTTPS_PORT=8443
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=bitte_aendern_grafana

