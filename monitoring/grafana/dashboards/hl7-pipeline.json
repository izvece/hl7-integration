{
  "uid": "hl7-pipeline",
  "title": "HL7 ADT - Verarbeitung",
  "description": "Zustand der ADT-Strecke: Durchsatz, haengende Nachrichten, Fehlerablage.",
  "tags": ["hl7", "integration"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "row",
      "title": "Zustand jetzt",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Aelteste unverarbeitete Nachricht",
      "description": "Das Kernsignal. Steigt dieser Wert, bleiben Nachrichten haengen. Ab 300 Sekunden feuert der Alarm.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "hl7_pipeline_oldest_unprocessed_seconds", "legendFormat": "Alter" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Rueckstau",
      "description": "Nachrichten im Status received, also angenommen aber nicht verarbeitet.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "hl7_pipeline_backlog", "legendFormat": "wartend" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "Letzte Nachricht vor",
      "description": "Stille ist kein Erfolg. Laeuft dieser Wert hoch, sendet das Quellsystem moeglicherweise nicht mehr.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "hl7_pipeline_last_message_age_seconds", "legendFormat": "vor" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 900 },
              { "color": "red", "value": 1800 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": { "-1": { "text": "noch keine", "color": "text", "index": 0 } }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "stat",
      "title": "MLLP-Listener",
      "description": "Nimmt der Port 6661 Verbindungen an? Geprueft von aussen durch den blackbox_exporter.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "probe_success{job=\"mllp-listener\"}", "legendFormat": "erreichbar" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "nicht erreichbar", "color": "red", "index": 0 },
                "1": { "text": "erreichbar", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "type": "row",
      "title": "Verlauf",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Nachrichten nach Status",
      "description": "Kumulierte Zaehler. Ein flacher Verlauf bei processed und gleichzeitig steigendes received bedeutet Stillstand.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "hl7_messages_total", "legendFormat": "{{status}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "processed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "received" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "type": "timeseries",
      "title": "Alter der aeltesten unverarbeiteten Nachricht",
      "description": "Saegezahn ist normal: der Wert steigt zwischen zwei Verarbeitungen und faellt zurueck auf 0. Ein durchgehender Anstieg ist das Warnzeichen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "hl7_pipeline_oldest_unprocessed_seconds", "legendFormat": "Alter" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false } }
    },
    {
      "type": "row",
      "title": "Fehlerablage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "type": "barchart",
      "title": "Offene Fehler nach Grund",
      "description": "Ein einzelner hoher Balken heisst meist: ein Sender hat sein Format geaendert.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        { "refId": "A", "expr": "hl7_errors_open_total", "legendFormat": "{{reason}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }
      }
    },
    {
      "type": "timeseries",
      "title": "Eingang je 5 Minuten",
      "description": "Der Durchsatz. Nuetzlich, um den Normalbetrieb zu kennen - ohne den laesst sich kein Schwellwert sinnvoll setzen.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        { "refId": "A", "expr": "hl7_pipeline_received_last_5m", "legendFormat": "Nachrichten" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false } }
    }
  ]
}
